# Description: CMatrix is based on the screensaver from The Matrix website.
# URL: https://github.com/abishekvashok/cmatrix
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: ncurses

name=cmatrix
version=2.0
release=1
source=(https://github.com/abishekvashok/$name/archive/refs/tags/v$version.tar.gz)

build() {
	cd $name-$version
	cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release
	cmake --build build -j ${JOBS:-1}
	DESTDIR=$PKG cmake --install build
}
