# Description: A window switcher, application launcher and dmenu replacement.
# URL: https://github.com/davatorium/rofi
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: pango gdk-pixbuf libxkbcommon startup-notification xorg-xcb-util xorg-xcb-util-wm xorg-xcb-util-cursor
# Was contrib/rofi (Matt Housh) until it was dropped; revived here. rofi 2.0
# is meson-only -- the old autotools build() no longer applies. No librsvg:
# SVG icons go through gdk-pixbuf's (optional) loader, not a build dep.

name=rofi
version=2.0.0
release=1
source=(https://github.com/davatorium/$name/releases/download/$version/$name-$version.tar.gz)

build() {
  meson setup build $name-$version \
    --prefix=/usr \
    --buildtype=plain \
    -D check=disabled \
    -D wayland=disabled

  ninja -C build
  DESTDIR=$PKG ninja -C build install

  rm -rf $PKG/usr/share/doc
}
