# Description: Small, modular, platform-aware live-system installer (work in progress)
# URL: https://github.com/dani-77/mocinha
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: python3 python3-gobject gtk3

# Experimental: it partitions and formats disks; test it on a disposable disk
# first. A live image ships it together with its own manifest
# (/etc/mocinha.toml, e.g. sysv-d77's overlay); see the project's STATUS.md.

name=mocinha
version=0.1.8
release=1
source=(https://github.com/dani-77/mocinha/archive/refs/tags/$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
  cd $name-$version

  install -d $PKG/usr/share/mocinha
  cp -r mocinha bin assets examples $PKG/usr/share/mocinha/
  find $PKG/usr/share/mocinha -name __pycache__ -prune -exec rm -rf {} +

  install -Dm755 packaging/common/mocinha.sh $PKG/usr/bin/mocinha
  install -Dm755 packaging/common/mocinha-root $PKG/usr/lib/mocinha/mocinha-root
  install -Dm644 packaging/common/org.mocinha.installer.policy \
    $PKG/usr/share/polkit-1/actions/org.mocinha.installer.policy
  install -Dm644 packaging/common/mocinha.desktop $PKG/usr/share/applications/mocinha.desktop
  install -Dm644 assets/mocinha-icon-256.png $PKG/usr/share/icons/hicolor/256x256/apps/mocinha.png
}
