# Description: Set the X11 root window wallpaper (maintained fork).
# URL: https://github.com/himdel/hsetroot
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: imlib2 xorg-libx11 xorg-libxinerama

name=hsetroot
version=1.0.5
release=1
source=(https://github.com/himdel/hsetroot/archive/$version/$name-$version.tar.gz)

build() {
  cd $name-$version

  # The Makefile builds its include/link flags from pkg-config and honours
  # CFLAGS/LDFLAGS only from the environment (CFLAGS?=). Its `install` target
  # ignores DESTDIR, so install the two binaries by hand.
  make

  install -D -m 0755 hsetroot    "$PKG"/usr/bin/hsetroot
  install -D -m 0755 hsr-outputs "$PKG"/usr/bin/hsr-outputs
}
