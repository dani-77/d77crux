drwxr-xr-x	root/root	usr/
drwxr-xr-x	root/root	usr/bin/
lrwxrwxrwx	root/root	usr/bin/discord -> /usr/share/discord/discord
drwxr-xr-x	root/root	usr/share/
drwxr-xr-x	root/root	usr/share/applications/
lrwxrwxrwx	root/root	usr/share/applications/discord.desktop -> /usr/share/discord/discord.desktop
drwxr-xr-x	root/root	usr/share/discord/
-rwxr-xr-x	root/root	usr/share/discord/discord
-rw-r--r--	root/root	usr/share/discord/discord.desktop
-rw-r--r--	root/root	usr/share/discord/discord.png
-rwxr-xr-x	root/root	usr/share/discord/updater_bootstrap
drwxr-xr-x	root/root	usr/share/pixmaps/
lrwxrwxrwx	root/root	usr/share/pixmaps/discord.png -> /usr/share/discord/discord.png
