# Description: A userspace virtual filesystem designed to work with the I/O abstractions of gio (glib)
# URL: https://wiki.gnome.org/Projects/gvfs
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# originally found at Jay Lanagan's crux-ports (codeberg.org/jlngn/xfce4)
# Depends on: docbook-xsl gsettings-desktop-schemas libcap libgcrypt libgudev libsecret libsoup3 libxslt polkit
# Optional: avahi fuse3 gcr libcdio-paranoia libgphoto2 samba udisks2

name=gvfs
version=1.62.0
release=1
source=(https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz)

build() {
  # enable optional backends only when their dependency is installed
  opt() { prt-get isinst $1 > /dev/null 2>&1 && echo true || echo false; }

  cd $name-$version

  # no elogind/systemd, and none of these libraries exist as ports here:
  # goa, google, onedrive (online accounts), mtp, nfs, bluray, afc
  meson setup build \
    --prefix=/usr \
    --libexecdir=/usr/lib/$name \
    -Dsystemduserunitdir=no \
    -Dtmpfilesdir=no \
    -Dlogind=false \
    -Dgoa=false \
    -Dgoogle=false \
    -Donedrive=false \
    -Dmtp=false \
    -Dnfs=false \
    -Dbluray=false \
    -Dafc=false \
    -Dman=true \
    -Dfuse=$(opt fuse3) \
    -Dudisks2=$(opt udisks2) \
    -Ddnssd=$(opt avahi) \
    -Dsmb=$(opt samba) \
    -Dgphoto2=$(opt libgphoto2) \
    -Dcdda=$(opt libcdio-paranoia) \
    -Dgcr=$(opt gcr)

  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -r $PKG/usr/share/locale
}
