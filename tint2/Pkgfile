# Description: Lightweight panel/taskbar.
# URL: https://gitlab.com/nick87720z/tint2
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: imlib2 startup-notification xorg-libxcomposite xorg-libxdamage xorg-libxinerama xorg-libxrandr
# Optional: librsvg
# Based on the contrib port by John McQuah, jmcquah at disroot dot org.

name=tint2
version=17.1.3
release=2
source=(https://gitlab.com/nick87720z/$name/-/archive/$version/$name-$version.tar.bz2
        $name-glib.patch)

build() {
  # Runtime use-after-free: callbacks drop list entries mid-iteration (systray
  # icon teardown, uevent handlers). Iterate over a copy instead.
  patch -p1 -d $name-$version -i "$SRC"/$name-glib.patch

  # Off-by-two in dir_end pointer arithmetic from upstream 120f72a77e8e:
  # strlen_const() replaced sizeof()-1 but the subtraction was not adjusted, so
  # the config dir path gets two trailing garbage bytes and tint2 fails to load
  # ~/.config/tint2/tint2rc.
  sed -e "/dir_end = userpath/s/);/) - 2;/" -i $name-$version/src/config.c

  # gcc 14 promotes these to errors; tint2 17.1.3 predates the fixes.
  export CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"

  # librsvg is only used to draw SVG launcher icons; ENABLE_RSVG=ON without it
  # is a hard CMake error, so gate it on the optional dep being installed.
  prt-get isinst librsvg && _rsvg=ON || _rsvg=OFF

  cmake -S $name-$version -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -D ENABLE_TINT2CONF=OFF \
    -D ENABLE_RSVG=$_rsvg \
    -Wno-dev

  ninja -C build -j ${JOBS:-1}
  DESTDIR=$PKG ninja -C build install

  rm -rf "$PKG"/{etc,usr/share/doc}
}
