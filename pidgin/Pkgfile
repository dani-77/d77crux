# Description: Pidgin is a chat program which lets you log into accounts on multiple chat networks simultaneously.
# URL: https://pidgin.im/
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: libpurple gtk xorg-libxscrnsaver startup-notification nss libidn xorg-libxdamage gtkspell

name=pidgin
version=2.14.14
release=1
source=(https://master.dl.sourceforge.net/project/pidgin/Pidgin/$version/pidgin-$version.tar.gz)

build() {
  cd $name-$version
  ./configure --prefix=/usr \
  --disable-gtkspell \
  --disable-gevolution \
  --disable-vv \
  --disable-idn \
  --disable-meanwhile \
  --disable-avahi \
  --disable-nm \
  --disable-tcl \
  --disable-gstreamer
  make
  make DESTDIR=$PKG install

  rm -rf $PKG/usr/share/locale/
}
