# Description: This is a patched version of xorg's transset.
# URL: https://forchheimer.se/transset-df/
# Maintainer: Daniel Azevedo, daniazevedo77 at posteo dot net
# Depends on: xorg

name=transset-df
version=6
release=2
source=(https://forchheimer.se/transset-df/$name-$version.tar.gz)

build() {
	cd $name-$version
	make
	# Upstream's install target ignores DESTDIR and copies to /usr/bin.
	install -Dm755 transset-df $PKG/usr/bin/transset-df
}
